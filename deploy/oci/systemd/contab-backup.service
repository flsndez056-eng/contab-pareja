[Unit]
Description=DúoCuenta - respaldo y restauración de verificación
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/contab-pareja
ExecStart=/bin/sh /opt/contab-pareja/deploy/oci/backup.sh
ExecStart=/bin/sh /opt/contab-pareja/deploy/oci/verify-backup.sh
Nice=10
IOSchedulingClass=idle
