APP_ENV=development
APP_NAME=Contab Pareja API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://contab:change-me@postgres:5432/contab_pareja
JWT_SECRET=replace-with-at-least-64-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=15
EMAIL_VERIFICATION_HOURS=24
EMAIL_ACTION_COOLDOWN_SECONDS=60
CORS_ORIGINS=[]
FCM_PROJECT_ID=contab-pareja
GOOGLE_APPLICATION_CREDENTIALS=
EMAIL_DELIVERY_MODE=disabled
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
ANDROID_DEEP_LINK_BASE=contabpareja://auth
ACCOUNT_ACTION_BASE_URL=https://contab.siptrapollo.online/auth
ANDROID_APP_CERT_SHA256=
